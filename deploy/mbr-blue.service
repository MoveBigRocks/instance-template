[Unit]
Description=Move Big Rocks Blue Slot (port 8080)
Documentation=https://github.com/movebigrocks/platform
After=network.target

[Service]
Type=simple
User=mbr
Group=mbr
WorkingDirectory=/opt/mbr

# Blue slot binary and port
ExecStart=/opt/mbr/mbr-blue
Environment=PORT=8080
Environment=HOST=127.0.0.1
# MBR_SLOT tells the core it is running as the blue slot. The core uses this to
# slot-scope the extension runtime socket directory
# (/opt/mbr/tmp/extensions/blue) and to supervise extension runtime processes as
# children of this slot. See RFC-0016.
Environment=MBR_SLOT=blue
Environment=EXTENSION_RUNTIME_DIR=/opt/mbr/tmp/extensions
Environment=EXTENSION_RUNTIME_BINARY_DIR=/opt/mbr/extensions-runtime/bin
Environment=EXTENSION_RUNTIME_MANIFEST_PATH=/opt/mbr/extensions/runtime-manifest.json

# Environment file for secrets and configuration
# NOTE: PORT and HOST must NOT be set in .env - each slot controls its own port
EnvironmentFile=/opt/mbr/.env

# Restart policy
Restart=always
RestartSec=5

# Security hardening
# Keep filesystem protections relaxed enough for local config, deploy assets,
# and optional filesystem-backed storage under /opt/mbr.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

# Resource limits
MemoryMax=2G
LimitNOFILE=65536

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mbr-blue

[Install]
WantedBy=multi-user.target
